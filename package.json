{
  "name": "dsh-enhance-prompt",
  "version": "0.5.0",
  "description": "One-click prompt enhancer for DeepSeek Harness — a reverse-engineered, benchmarked reimplementation of WorkBuddy's Enhance prompt.",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test test/anchors.test.mjs test/prompts.test.mjs test/client.test.mjs test/contract.test.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/anchors.js && node --check lib/prompts.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugin-ui",
    "deepseek-harness",
    "deepseek",
    "prompt",
    "prompt-engineering",
    "enhance-prompt"
  ],
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "docs/compare-report.md",
    "docs/audit-v0.4.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tong174/dsh-enhance-prompt.git"
  },
  "homepage": "https://github.com/tong174/dsh-enhance-prompt#readme",
  "bugs": {
    "url": "https://github.com/tong174/dsh-enhance-prompt/issues"
  },
  "author": "tong174",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.2 <0.4.0-0"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
